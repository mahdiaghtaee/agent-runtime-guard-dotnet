{
  "Policy": {
    "DefaultEffect": "RequireApproval",
    "DefaultReason": "No policy rule matched. Explicit approval is required.",
    "Rules": [
      {
        "Id": "allow-workspace-reads",
        "Priority": 100,
        "Effect": "Allow",
        "ToolPattern": "filesystem",
        "OperationPattern": "read",
        "ResourcePattern": "*",
        "Reason": "Read-only workspace access is allowed."
      },
      {
        "Id": "review-database-writes",
        "Priority": 200,
        "Effect": "RequireApproval",
        "ToolPattern": "database",
        "OperationPattern": "write",
        "ResourcePattern": "*",
        "Reason": "Database writes require an explicit approval step."
      },
      {
        "Id": "deny-production-shell",
        "Priority": 300,
        "Effect": "Deny",
        "ToolPattern": "shell",
        "OperationPattern": "execute",
        "ResourcePattern": "production:*",
        "Reason": "Shell execution against production resources is blocked by the starter policy."
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
